---
interface Props {
  src: string;
  alt: string;
  caption: string;
}
const { src, alt, caption } = Astro.props;
---
<figure class="my-5">
  <img src={src} alt={alt} loading="lazy"
    class="w-full rounded-xl border border-card-border" />
  <figcaption class="font-mono text-[11px] leading-[1.5] text-ink/60 mt-2.5">
    {caption}
  </figcaption>
</figure>
